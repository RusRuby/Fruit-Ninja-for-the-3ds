name: Build 3DS CIA

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    container: devkitpro/devkitarm:latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Compile Code
        run: |
          make

      - name: Setup Python
        run: |
          dkp-pacman -Sy --noconfirm python python-pip || true
          pip install 3dsx2cia --break-system-packages || pip install 3dsx2cia || true

      - name: Convert 3DSX to CIA
        run: |
          3DSX_FILE=$(find . -name "*.3dsx" -type f | head -n 1)
          python3 -m 3dsx2cia "$3DSX_FILE" fruitninja3ds.cia || 3dsx2cia "$3DSX_FILE" fruitninja3ds.cia

      - name: Upload Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: FruitNinja-3DS-Build
          path: |
            *.cia
            **/*.cia
            **/*.3dsx
